generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Transaction {
  id          String   @id @default(uuid())
  description String
  amount      Float
  type        String   // Aqui vamos salvar 'entrada' ou 'saida'
  createdAt   DateTime @default(now())
}